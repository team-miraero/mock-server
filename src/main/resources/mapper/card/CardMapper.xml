<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jejuro.miraero.mock_server.card.mapper.CardMapper">
    <select id="findCards"
            resultType="Card">
        SELECT card_id,
               kb_user_id,
               card_name,
               card_type,
               financial_institution_code
        FROM card
        WHERE kb_user_id = #{kbUserId}
    </select>
</mapper>