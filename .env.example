# Active Spring profile: local or dev
SPRING_PROFILES_ACTIVE=local

# Server
SERVER_PORT=9000

# MySQL container
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mock
MYSQL_USER=mock
MYSQL_PASSWORD=

# Spring datasource
DB_URL=jdbc:mysql://localhost:3307/mock?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=mock
DB_PASSWORD=

# Mock OAuth (server-to-server auth for /mock/oauth/**)
MOCK_OAUTH_CLIENT_SECRET=
MOCK_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
MOCK_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
